# Environment Configuration
ENVIRONMENT=dev

# AI API Configuration
AI_API_URL=http://ai-api:8000

# Orchestration Configuration
ORCHESTRATION_API_URL=http://orchestration-api:3000
PORT=3000

# Terraform Configuration
TF_VAR_environment=dev
TF_VAR_provider_type=docker
TF_VAR_node_count=2

# Monitoring Configuration
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=asylum_admin_2024

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Scheduler Configuration
ANALYSIS_INTERVAL=*/15 * * * *
DRIFT_CHECK_INTERVAL=0 */6 * * *
MODEL_RETRAIN_INTERVAL=0 2 * * *

# Security (DO NOT COMMIT REAL CREDENTIALS)
# Use environment variables or secret management in production
SECRET_KEY=change_this_in_production
